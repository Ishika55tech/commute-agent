# Copy to .env (never commit .env). Only PUBLIC values belong here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Optional, public: Uber client_id from developer.uber.com (link works without it)
EXPO_PUBLIC_UBER_CLIENT_ID=

# SECRETS DO NOT GO HERE. Set them as Supabase Edge Function secrets:
#   supabase secrets set GEMINI_API_KEY=... ORS_API_KEY=...
